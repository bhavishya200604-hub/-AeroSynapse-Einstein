// generated by scripts: the D3Q19 BGK + Smagorinsky collision, unrolled (f in, post-collision out)
static inline void lbm_collide(float* f, float tau0, float smag, float& r, float& ux, float& uy, float& uz, float& tau, long& clamps, bool& bad, float ax, float ay, float az) {
    r = f[0] + f[1] + f[2] + f[3] + f[4] + f[5] + f[6] + f[7] + f[8] + f[9] + f[10] + f[11] + f[12] + f[13] + f[14] + f[15] + f[16] + f[17] + f[18];
    if (!(r > 0.05f) || !(r < 20.f)) { r = 1.f; bad = true; }
    float ir = 1.f / r;
    ux = (f[1] - f[2] + f[7] - f[8] + f[9] - f[10] + f[11] - f[12] + f[13] - f[14]) * ir;
    uy = (f[3] - f[4] + f[7] - f[8] - f[9] + f[10] + f[15] - f[16] + f[17] - f[18]) * ir;
    uz = (f[5] - f[6] + f[11] - f[12] - f[13] + f[14] + f[15] - f[16] - f[17] + f[18]) * ir;
    ux += tau0 * ax; uy += tau0 * ay; uz += tau0 * az;  // a body force (buoyancy): the equilibrium velocity shifted (Shan-Chen)
    float u2 = ux * ux + uy * uy + uz * uz;
    if (u2 > 0.09f) { float s = 0.3f / std::sqrt(u2); ux *= s; uy *= s; uz *= s; u2 = 0.09f; ++clamps; }
    float Pxx = (f[1] + f[2] + f[7] + f[8] + f[9] + f[10] + f[11] + f[12] + f[13] + f[14]) - (r * ux * ux + r * (1.f / 3));
    float Pyy = (f[3] + f[4] + f[7] + f[8] + f[9] + f[10] + f[15] + f[16] + f[17] + f[18]) - (r * uy * uy + r * (1.f / 3));
    float Pzz = (f[5] + f[6] + f[11] + f[12] + f[13] + f[14] + f[15] + f[16] + f[17] + f[18]) - (r * uz * uz + r * (1.f / 3));
    float Pxy = (f[7] + f[8] - f[9] - f[10]) - (r * ux * uy);
    float Pxz = (f[11] + f[12] - f[13] - f[14]) - (r * ux * uz);
    float Pyz = (f[15] + f[16] - f[17] - f[18]) - (r * uy * uz);
    float Q = Pxx * Pxx + Pyy * Pyy + Pzz * Pzz + 2.f * (Pxy * Pxy + Pxz * Pxz + Pyz * Pyz);
    tau = 0.5f * (tau0 + std::sqrt(tau0 * tau0 + smag * std::sqrt(Q) * ir));
    float om = 1.f / tau, usq = 1.5f * u2;
    f[0] -= om * (f[0] - (1.f / 3) * r * (1.f - usq));
    { float cu = 3.f * (ux); f[1] -= om * (f[1] - (1.f / 18) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-ux); f[2] -= om * (f[2] - (1.f / 18) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (uy); f[3] -= om * (f[3] - (1.f / 18) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-uy); f[4] -= om * (f[4] - (1.f / 18) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (uz); f[5] -= om * (f[5] - (1.f / 18) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-uz); f[6] -= om * (f[6] - (1.f / 18) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (ux + uy); f[7] -= om * (f[7] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-ux - uy); f[8] -= om * (f[8] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (ux - uy); f[9] -= om * (f[9] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-ux + uy); f[10] -= om * (f[10] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (ux + uz); f[11] -= om * (f[11] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-ux - uz); f[12] -= om * (f[12] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (ux - uz); f[13] -= om * (f[13] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-ux + uz); f[14] -= om * (f[14] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (uy + uz); f[15] -= om * (f[15] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-uy - uz); f[16] -= om * (f[16] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (uy - uz); f[17] -= om * (f[17] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
    { float cu = 3.f * (-uy + uz); f[18] -= om * (f[18] - (1.f / 36) * r * (1.f + cu + 0.5f * cu * cu - usq)); }
}
